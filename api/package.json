{
  "name": "rustdesk-api",
  "version": "0.1.0",
  "private": true,
  "description": "RustDesk API server (account login, address books, devices, audit, strategies) with an OpenAPI-documented admin console, for this rustdesk-server fork.",
  "type": "module",
  "license": "AGPL-3.0",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build:web": "bun web/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@scalar/hono-api-reference": "0.12.26",
    "hono": "4.13.23",
    "oauth4webapi": "3.8.9",
    "preact": "10.29.8",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "typescript": "5.9.3"
  }
}
